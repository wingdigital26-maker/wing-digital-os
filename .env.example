# Wing Digital OS — environment variables
# Copy to .env.local for local dev, or set these in the Vercel project settings.
# NEVER commit real values. Placeholders only below.

# ── Required for the app to boot / auth ────────────────────────────────────────
OS_PASSWORD=                 # Single shared login password. Middleware fails CLOSED if unset (except NODE_ENV=development).
RUNTIME_ENV=cloud            # Set to "cloud" on the hosted deploy so local-only routes (python/CLI) return a graceful "PC needed" 503. Leave unset locally.

# ── Vault source (where the Obsidian markdown is read from) ────────────────────
VAULT_SOURCE=github          # "github" reads the vault from GitHub (cloud). Unset/anything else = read the local filesystem.
GH_VAULT_TOKEN=              # GitHub token with read access to the private repo wingdigital26-maker/wing-os-vault. Required when VAULT_SOURCE=github.
VAULT_PATH=                  # LOCAL ONLY: absolute path to the Obsidian vault. Defaults to Jack's OneDrive path if unset. Ignored when VAULT_SOURCE=github.
GH_VAULT_BRANCH=main         # Optional: branch of the vault repo to read (default "main").

# ── Required for the GHL dashboard panels ──────────────────────────────────────
GHL_API_KEY=                 # GoHighLevel API key / private integration token for the main Wing Digital location.
GHL_LOCATION_ID=             # GoHighLevel location id for the main Wing Digital account.
JACKSON_DASHBOARD_KEY=       # Unguessable key gating the public Jackson client dashboard (/api/jackson*, passed as ?k=). Fails CLOSED if unset.
GHL_JACKSON_ROOFING_PIT=     # Jackson Roofing sub-account Private Integration Token (read-only client dashboard).
# Per-client GHL panels follow the pattern GHL_<CLIENT_SLUG>_PIT, e.g.:
# GHL_ACME_ROOFING_PIT=      # PIT for the "acme-roofing" client's GHL sub-account (used by /api/clients/ghl).

# ── Optional (features degrade cleanly if unset) ───────────────────────────────
ANTHROPIC_API_KEY=           # Claude API key — powers /api/chat/claude, /api/vault/summarize, and the Jarvis API fallback.
GROQ_API_KEY=                # Groq API key — powers /api/chat/hermes and competitor-research summarization.
BRAVE_SEARCH_API_KEY=        # Brave Search API key — enables live competitor research (/api/agents/competitor-research).
NEXT_PUBLIC_BASE_URL=        # Base URL the chat routes use to self-call /api/agents/tools. Defaults to http://localhost:3000.

# ── Local-PC only (no effect / not needed in the cloud) ────────────────────────
CLAUDE_CLI_PATH=             # LOCAL ONLY: path to claude.exe for the Jarvis Claude Code engine.
ALLOW_REMOTE_CLAUDE_CODE=    # LOCAL ONLY: set to 1 to allow the claude-code bridge over a tunnel. Leave unset.
