# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local databases (never commit — these live on Jack's laptop only)
*.db
*.sqlite
*.sqlite3

# local logs and machine-local session/usage state
*.log
os-server.log
.jarvis-session.json
.brave-usage.json

# typescript
*.tsbuildinfo
next-env.d.ts

.env.local
wingdigital-site/
tools/__pycache__/
__pycache__/
